{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audmi.local/schemas/finding.schema.json",
  "title": "AudMi Finding v1",
  "description": "A potential supervisory indicator for human review, produced by one versioned rule. Mirrors src/core/findings.py (Finding.to_dict). Not a compliance judgment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "rule_id", "rule_version", "capability", "category",
    "cse_id", "subject_type", "subject_id", "reason", "supporting_record_ids",
    "baseline", "data_quality_notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string", "minLength": 1, "description": "Matches the id of a rule in rules/*.yaml." },
    "rule_version": { "type": "string", "minLength": 1 },
    "capability": {
      "type": "string",
      "enum": [
        "threat_detection", "investigation", "escalation", "incident_response",
        "security_operations", "governance_oversight", "operational_discipline", "cyber_resilience"
      ]
    },
    "category": { "type": "string", "enum": ["execution_gap", "negative_space", "anomaly"] },
    "cse_id": { "type": "string", "minLength": 1 },
    "subject_type": { "type": "string", "enum": ["case", "asset", "investigation", "entity"] },
    "subject_id": { "type": "string", "minLength": 1 },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "[Pp]otential",
      "description": "Plain-language explanation. Must describe a potential indicator, never a verdict."
    },
    "supporting_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Evidence chain: IDs of the canonical records behind the finding."
    },
    "baseline": {
      "type": "object",
      "description": "Numbers and expectations the rule used to decide (thresholds, medians, observed values)."
    },
    "data_quality_notes": { "type": "array", "items": { "type": "string" } }
  }
}
